        "uncertainty": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["CALIBRADO", "VENCIDO", "MANUTENCAO"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "certificateAttachment": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "serialNumber", "certificateNumber", "calibrationDate", "nextCalibrationDate", "status", "createdAt", "serverUpdatedAt"]
    },
    "DeletedTombstone": {
      "title": "DeletedTombstone",
      "description": "Registro de exclusão permanente para evitar ressurreição em sincronizações offline.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "deletedAt", "serverUpdatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Usuário administrador autorizado.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "createdAt"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Documento de teste de conectividade Firestore.",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
